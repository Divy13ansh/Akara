# Frontend env — copy to .env.local if overriding defaults.
# Composed mode (docker compose up): no vars needed — nginx proxies same-origin /api.
# Vite dev mode: point at the API directly.

# API base for fetch calls (empty = same origin)
VITE_API_BASE=

# Google Identity Services client (GIS button / One Tap)
VITE_GOOGLE_CLIENT_ID=354190554871-c313vjstblmkcoqk2ulqja9ed65fagp0.apps.googleusercontent.com
