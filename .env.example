# Akara API — template. Copy to .env.local and fill in.
# Live values live in .env.local (gitignored); the ones below marked with a
# value are compose/dev defaults.

# ── Postgres / Redis (compose defaults — match docker-compose.yml) ──
DATABASE_URL=postgresql+psycopg://akara:akara@localhost:5432/akara
ASYNC_DATABASE_URL=postgresql+asyncpg://akara:akara@localhost:5432/akara
REDIS_URL=redis://localhost:6379/0

# ── Auth (generate: openssl rand -hex 32) ──────────────────────
JWT_SECRET=
WEBHOOK_SECRET=

# ── Google OAuth (GIS id_token flow; JS origins registered) ────
# GOOGLE_CLIENT_ID must include the client id the web app was built with
# (VITE_GOOGLE_CLIENT_ID). Extra client ids (localhost, preview deploys) can
# be comma-separated in GOOGLE_CLIENT_IDS.
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=

# ── Cloudflare R2 (bucket: akara; public r2.dev enabled) ───────
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=akara
MEDIA_CDN_BASE=

# ── Service URLs ───────────────────────────────────────────────
VIDEO_SERVICE_URL=http://video:8001
AKARA_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000,http://localhost

# ── LiveKit (voice) ────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Azure OpenAI (scorer LLM) ──────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# ── Azure Speech (video TTS) ───────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── VEXYL-STT (voice, self-hosted — runs as the `stt` compose service) ──
VEXYL_STT_HOST=127.0.0.1
VEXYL_STT_PORT=8091
VEXYL_STT_LANG=hi-IN

# ── HuggingFace (REQUIRED for the `stt` service on a fresh VPS) ──
# The ai4bharat/indic-conformer-600m-multilingual repo is GATED: request
# access at https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual
# then paste a token with read access. It is used once, on first boot, to
# download the ~2.4GB model into the `stt_models` docker volume.
HF_TOKEN=
